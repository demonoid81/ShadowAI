# ShadowAI Development Environment Variables
# Used with docker compose or local `go run ./cmd/shadowai`.
# Safe defaults — NOT for production.

APP_ENV=development
SERVER_PORT=8080
DATABASE_URL=postgres://shadowai:shadowai_secret@localhost:5432/shadowai?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-not-for-prod-32chars!!
AUDIT_PAYLOAD_MODE=redacted
AUDIT_RETENTION_DAYS=0                         # no auto-purge in dev
AUDIT_ALLOW_NO_RETENTION_IN_PROD=false
STREAMING_MODE=buffered
FIREWALL_ENABLED=true
