# ShadowAI Production Environment Variables
# Copy to prod.env, fill in secrets, and inject via K8s Secrets or Vault.
# NEVER commit a filled-in prod.env to version control.
#
# Required → must be set; optional → has a safe default.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=production
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Database (Required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://shadowai:<PASSWORD>@postgres.<NAMESPACE>.svc.cluster.local:5432/shadowai?sslmode=require

# ---------------------------------------------------------------------------
# Redis (Required)
# ---------------------------------------------------------------------------
REDIS_URL=redis://:<PASSWORD>@redis.<NAMESPACE>.svc.cluster.local:6379/0

# ---------------------------------------------------------------------------
# Auth (Required)
# ---------------------------------------------------------------------------
JWT_SECRET=<STRONG_RANDOM_32+CHARS>

# ---------------------------------------------------------------------------
# LLM Providers (at least one required for proxy to function)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
GROQ_API_KEY=...
OPENROUTER_API_KEY=...

# ---------------------------------------------------------------------------
# Audit & Compliance
# ---------------------------------------------------------------------------
AUDIT_PAYLOAD_MODE=redacted                    # none|metadata|redacted|full
AUDIT_RETENTION_DAYS=90
AUDIT_PURGE_INTERVAL=24h
AUDIT_PURGE_CHUNK_SIZE=1000
AUDIT_ALLOW_NO_RETENTION_IN_PROD=false         # must be explicit true if days=0
AUDIT_CHAIN_SECRET=<STRONG_RANDOM_32+CHARS>    # required for WORM chain (PR-W2)

# ---------------------------------------------------------------------------
# WORM Evidence Anchors (optional but recommended in enterprise)
# ---------------------------------------------------------------------------
AUDIT_ANCHOR_INTERVAL=1h
AUDIT_ANCHOR_SINK=immudb://                    # file:// or immudb://
AUDIT_IMMUDB_ADDR=immudb.svc.cluster.local:3322
AUDIT_IMMUDB_USERNAME=shadowai
AUDIT_IMMUDB_PASSWORD=<IMMUDB_PASSWORD>
AUDIT_IMMUDB_DATABASE=shadowai
AUDIT_IMMUDB_REST_PROFILE=immudb_v2
AUDIT_ANCHOR_SIGNING_KEY=<BASE64_ED25519_PRIVATE_KEY>
AUDIT_ANCHOR_PUBKEY_ID=ed25519-prod-k1
AUDIT_ANCHOR_PUBKEY=<BASE64_ED25519_PUBLIC_KEY>

# ---------------------------------------------------------------------------
# SIEM (optional; enterprise)
# ---------------------------------------------------------------------------
SIEM_ENABLED=false
# SIEM_ENDPOINT=https://siem.example.com/ingest
# SIEM_BEARER_TOKEN=<TOKEN>
# SIEM_QUEUE_SIZE=1000
# SIEM_BATCH_SIZE=50
# SIEM_FLUSH_INTERVAL=5s
# SIEM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# OIDC Enterprise Auth (optional; enterprise)
# ---------------------------------------------------------------------------
OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=<CLIENT_ID>
# OIDC_CLIENT_SECRET=<CLIENT_SECRET>
# OIDC_REDIRECT_URL=https://api.shadowai.example.com/api/auth/oidc/callback
# OIDC_AUTO_PROVISION=false
# OIDC_LINK_BY_EMAIL=false
# OIDC_ROLE_MAP_JSON={"admins":"admin","engineers":"user"}
# OIDC_DEPARTMENT_CLAIM=department

# ---------------------------------------------------------------------------
# Governance (optional; enterprise)
# ---------------------------------------------------------------------------
LEGAL_HOLD_TOKEN_SECRET=<STRONG_RANDOM_32+CHARS>  # required in enterprise prod

# ---------------------------------------------------------------------------
# Firewall (defaults shown; tune per deployment)
# ---------------------------------------------------------------------------
FIREWALL_ENABLED=true
FIREWALL_SA_V2_ENABLED=false               # enable after corpus is ready
# FIREWALL_EMBEDDING_ENDPOINT=https://ollama.internal:11434
# FIREWALL_SA_V2_CORPUS_PATH=/firewall_corpus/semantic_v2.json
# FIREWALL_SA_V2_SHADOW_ONLY=true          # safe rollout mode

# ---------------------------------------------------------------------------
# Streaming (default safe; incremental requires explicit opt-in)
# ---------------------------------------------------------------------------
STREAMING_MODE=buffered
# STREAMING_ALLOW_INCREMENTAL_IN_PROD=true  # only after shadow validation
